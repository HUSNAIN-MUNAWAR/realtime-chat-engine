APP_NAME=Real-Time-Chat-Engine-for-100k-Users
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=change-me-super-secret-local-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=postgresql+asyncpg://chat:chat@postgres:5432/chat
SYNC_DATABASE_URL=postgresql+psycopg2://chat:chat@postgres:5432/chat
REDIS_URL=redis://redis:6379/0
SEED_DEMO_DATA=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345!
ENABLE_LOAD_TEST_ENDPOINTS=true
LOAD_TEST_SECRET=local-load-test-secret
MAX_MESSAGE_BYTES=4096
MESSAGE_RATE_LIMIT_PER_MINUTE=120
PRESENCE_TTL_SECONDS=45
RISK_MODEL_PATH=/app/mlops/models/current/risk_model.json
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
